{
  "name": "@james-tanuwidjaja/vue3-components",
  "version": "0.4.1",
  "description": "A reusable Vue 3 component library with a Vuetify-style createJt() plugin, precompiled CSS, and Storybook docs.",
  "type": "module",
  "license": "MIT",
  "author": "James Tanuwidjaja",
  "repository": {
    "type": "git",
    "url": "https://github.com/james-tanuwidjaja/vue3-components-library.git"
  },
  "homepage": "https://github.com/james-tanuwidjaja/vue3-components-library#readme",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "component-library",
    "ui",
    "tailwind"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/vue3-components.css"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "^10.4.4",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.5.0",
    "eslint-plugin-storybook": "^10.4.4",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "storybook": "^10.4.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8",
    "vue": "^3.5.38",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  }
}
